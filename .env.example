# Kuchu Puchu backend — example environment.
# Copy to .env and fill in. NEVER commit .env.
# Generate secrets via: openssl rand -base64 48

# --- App ---
NODE_ENV=development            # development | test | staging | production
PORT=3000
# Process type: api | realtime | worker (default api). `node dist/main` runs the chosen role.
# APP_ROLE=api
# Comma-separated list of allowed browser origins. REQUIRED in production.
# In non-production, if empty, http://localhost:<port> and http://127.0.0.1:<port> are allowed.
CORS_ORIGINS=
# Express "trust proxy": number of hops (e.g. 1), true/false, or a subnet list.
# REQUIRED in production.
TRUST_PROXY=
# fatal | error | warn | info | debug | trace (default: info in prod, debug otherwise)
LOG_LEVEL=debug
# Serve Swagger at /api/docs (default: true outside production)
SWAGGER_ENABLED=true

# --- Database (MySQL 8.4 LTS or newer; MariaDB is refused at startup) ---
# Local setup: see README "Local MySQL 8.4" (Homebrew mysql@8.4 on port 3307).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=kuchu_puchu
DB_PASSWORD=
DB_NAME=kuchu_puchu
# Max connections per instance (min is fixed at 2)
DB_POOL_MAX=20
# Logs SQL at debug level (bind parameters are never logged)
DB_LOGGING=false
DB_SSL=false

# --- JWT --- (secrets: min 32 chars; all three secrets must differ; openssl rand -base64 48)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_ISSUER=kuchu-puchu
JWT_AUDIENCE=kuchu-puchu-app

# --- Sessions (M06) ---
# Each refresh moves expires_at to now + SESSION_SLIDING_DAYS; a session never outlives SESSION_MAX_DAYS from sign-in.
SESSION_SLIDING_DAYS=30
SESSION_MAX_DAYS=90
# Live sessions per user; signing in on one more device revokes the least recently used session.
SESSION_MAX_PER_USER=10

# --- OTP ---
# HMAC secret for hashing OTPs (min 32 chars; openssl rand -base64 48)
OTP_HASH_SECRET=
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
# Per request IP (mobile carrier NAT puts many users behind one IP)
OTP_MAX_PER_IP_PER_HOUR=20
# Per X-Device-Id header; requests without one share a bucket per IP.
OTP_MAX_PER_DEVICE_PER_HOUR=10
# Step-up (re-auth) codes per identifier per hour, counted apart from sign-in codes.
OTP_REAUTH_MAX_PER_HOUR=5
# Calling codes that may receive SMS codes, comma-separated. Others get the same 200 but no SMS.
OTP_SMS_ALLOWED_COUNTRIES=+91
# Prints OTPs to stdout — development only. Rejected at startup in production.
OTP_DEV_ECHO=false

# --- SMS / Email (M06) ---
# Only "fake" exists until the DLT-registered provider is added. Production refuses unset or "fake".
SMS_PROVIDER=fake
# SMS_API_KEY=
# SMS_SENDER_ID=
# SMS_DLT_TEMPLATE_ID=
# SMS codes per IST day across all users, split into two pools; each alerts at 80 % and stops at 100 %.
SMS_DAILY_BUDGET=10000
# Share (%) for numbers no account holds yet; the rest is reserved for existing accounts.
SMS_BUDGET_NEW_IDENTIFIER_PERCENT=70
# OTP emails per IST day across all users: alert at 80 %, stop sending at 100 %.
EMAIL_DAILY_BUDGET=20000
# With both set, OTP emails go through Amazon SES (IAM role credentials); otherwise a fake. Required in production.
# EMAIL_FROM=no-reply@example.com
# SES_REGION=ap-south-1

# Product limits (max interests, distance range, …) are not env variables since M08:
# they live in the app_settings table (seeded by `npm run seed`) and are read through SettingsService.

# --- Redis ---
# redis://[:password@]host:port[/db]  (rediss:// for TLS). REQUIRED in production;
# defaults to redis://localhost:6379 elsewhere. Tests always use DB 15 or a container.
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# --- AWS / storage (M07; credentials come from the IAM role, never keys) ---
# With both set, data exports go to S3 (private bucket, Block Public Access). Both are required in production.
# AWS_REGION=ap-south-1
# S3_BUCKET_PRIVATE=
# Without them, a local-filesystem fake is used (development and test). Default: the OS temp directory.
# STORAGE_LOCAL_DIR=

# --- Push / FCM (future) ---
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# --- Outbox and background jobs (worker process; defaults shown) ---
# Relay tick interval, and the time budget within a tick (must be below the interval).
# OUTBOX_RELAY_INTERVAL_MS=1000
# OUTBOX_RELAY_TIME_BUDGET_MS=800
# Events per relay batch (a tick keeps taking batches until one is short).
# OUTBOX_BATCH_SIZE=200
# Relay attempts per event (Redis unreachable) and BullMQ attempts per handler.
# OUTBOX_MAX_ATTEMPTS=8
# Backoff base: retry after base x 2^n.
# OUTBOX_BACKOFF_BASE_MS=1000
# Longest the relay waits for Redis to accept a batch.
# OUTBOX_ENQUEUE_TIMEOUT_MS=1000
# Done events older than this are deleted daily; failed events are never deleted.
# OUTBOX_CLEANUP_AGE_DAYS=7
# Cleanup schedule, cron in UTC (21:30 UTC = 03:00 IST).
# OUTBOX_CLEANUP_CRON=30 21 * * *
# publish() rejects payloads larger than this (bytes of JSON).
# OUTBOX_PAYLOAD_MAX_BYTES=16384
# BullMQ retention: completed handler jobs (also the jobId dedupe window) and failed jobs.
# OUTBOX_COMPLETED_JOB_RETENTION_HOURS=24
# OUTBOX_FAILED_JOB_RETENTION_DAYS=14

# --- Security audit retention (worker; defaults shown) ---
# SECURITY_EVENTS_RETENTION_DAYS=365
# admin.* events
# SECURITY_EVENTS_ADMIN_RETENTION_DAYS=1095
# Cron in UTC (21:45 UTC = 03:15 IST)
# SECURITY_EVENTS_RETENTION_CRON=45 21 * * *

# --- Monitoring ---
# Sentry is enabled only when this is set. No request data or user details are sent.
# SENTRY_DSN=
# Slack-compatible incoming webhook for job alerts (event type, id and error class only).
# REQUIRED in production; elsewhere alerts are only logged when it is unset.
# ALERT_WEBHOOK_URL=

# --- NestJS Observe (optional; enabled only when both are set) ---
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
